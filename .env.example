# .env.example — template for server-side secrets
# Copy this file to ".env.local" for local development with "vercel dev",
# then add your token after the "=" in YOUR EDITOR (never in chat or source code).
# ".env" and ".env.local" are listed in .gitignore and must never be committed.
# In production, set this value in Vercel: Project → Settings → Environment Variables.

TMDB_READ_ACCESS_TOKEN=
